### Database — Neon Postgres ###############################################
# Pooled connection, used by the app at runtime (note the `-pooler` host).
# Vercel's Neon integration injects this automatically on deploy.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection, used by the Prisma CLI for migrations and Studio.
# For a plain local Postgres you can omit this — it falls back to DATABASE_URL.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

### Auth.js ################################################################
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Public base URL. Leave unset on Vercel — it is inferred from the deployment.
# AUTH_URL="http://localhost:3000"

### Admin seed account (npm run seed) ######################################
# The seed script refuses to run with a password shorter than 12 characters.
ADMIN_NAME="Subidha Gas Admin"
ADMIN_EMAIL="admin@subidhagas.com.np"
ADMIN_PASSWORD="change-this-long-password"

### Nightly stock reset ####################################################
# Vercel Cron sends this as `Authorization: Bearer <value>` to
# /api/cron/reset-stock (scheduled 18:15 UTC = midnight Asia/Kathmandu).
# Generate with: openssl rand -hex 32
# Required in production — without it the scheduled run is unauthenticated.
CRON_SECRET="replace-me-with-a-random-hex-string"

### Import script ##########################################################
# Path to the KML export. Defaults to the bundled folder if unset.
# KML_PATH="./Maruti Gas Dealer (1).kmz/doc.kml"

# Nominatim requires a contact address in the User-Agent per its usage policy.
GEOCODE_CONTACT="ops@subidhagas.com.np"

### Public site ############################################################
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
